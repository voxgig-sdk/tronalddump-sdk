# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: {
    appeared_at: {
      fo: "date-time"
      h: "Appeared At"
      n: "appeared_at"
      r: false
      sh: "The date and time when the quote appeared"
      t: "`$STRING`"
    }
    count: {
      h: "Count"
      n: "count"
      r: false
      sh: "Total number of quotes found"
      t: "`$INTEGER`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "The date and time when the quote was created in the system"
      t: "`$STRING`"
    }
    embedded: {
      h: "Embedded"
      n: "embedded"
      r: false
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    links: {
      h: "Links"
      n: "links"
      r: false
      sh: "HATEOAS links for pagination"
      t: "`$OBJECT`"
    }
    quote_id: {
      h: "Quote Id"
      n: "quote_id"
      r: false
      sh: "Unique identifier for the quote"
      t: "`$STRING`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: false
      sh: "Tags associated with the quote"
      t: "`$ARRAY`"
    }
    total: {
      h: "Total"
      n: "total"
      r: false
      sh: "Total number of quotes available"
      t: "`$INTEGER`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "The date and time when the quote was last updated"
      t: "`$STRING`"
    }
    value: {
      h: "Value"
      n: "value"
      r: false
      sh: "The actual quote text"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /random/quote"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/random/quote"
          s: [
            {
              lit: "random"
            }
            {
              lit: "quote"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /search/quote"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 0
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "query"
                or: "query"
                r: true
                t: "`$STRING`"
              }
              {
                ex: 25
                k: "query"
                n: "size"
                or: "size"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/search/quote"
          q: {
            exist: [
              "page"
              "query"
              "size"
            ]
          }
          s: [
            {
              lit: "search"
            }
            {
              lit: "quote"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /quote/{quote_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "quote_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/quote/{quote_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              quote_id: "id"
            }
          }
          s: [
            {
              lit: "quote"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
